{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build.mjs",
  "installCommand": "npm ci --omit=dev",
  "outputDirectory": "dist",
  "regions": [
    "icn1"
  ],
  "functions": {
    "api/product-lookup.js": {
      "includeFiles": "data/**"
    },
    "api/analyze.py": {
      "maxDuration": 120,
      "includeFiles": "private-model/**",
      "excludeFiles": "{data/**,scripts/**,models/**,vendor/**,dist/**,src/**,examples/**,licenses/**,.git/**}"
    }
  },
  "headers": [
    {
      "source": "/vendor/litert-2.5.3/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/model-download/:version/:part",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/model-download/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/models/pill-deim-27940a50.:part",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
